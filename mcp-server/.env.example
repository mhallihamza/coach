MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.f4idzbv.mongodb.net/coach?retryWrites=true&w=majority
MCP_AGENT_CONTEXT=userId-comes-from-backend-jwt
LOG_LEVEL=info

# Specialist flow configuration (A2A delegation) — every workflow carries its OWN named jeton.
# Shared fallback intentionally unused: the named tokens below are the single source of truth.
# To change one workflow only: edit its TOKEN line, then restart the MCP server.
LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=
# ANALYSIS_API_TOKEN=Bearer <legacy shared jeton>   ← do not use
LANGFLOW_TIMEOUT_MS=90000

# Per-flow endpoints and tokens — same staging jeton today, edit individually later
SELF_DISCOVERY_URL=https://stg-agentic.abafusion.ai/api/v1/run/self_discovery
SELF_DISCOVERY_TOKEN=Bearer <same-staging-jwt-for-now>
