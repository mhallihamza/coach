# Evolve AI — backend environment example. Copy to .env and fill in. Never commit.
# Every workflow carries its OWN named jeton below (even if they are identical today).
# To change one workflow only: edit its TOKEN line, then restart the backend.

# MongoDB (Atlas or self-hosted) — database coach
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/coach?retryWrites=true&w=majority
DATABASE_NAME=coach

# JWT signing
JWT_SECRET=<change-me-to-a-long-random-string>
JWT_EXPIRES_MINUTES=43200

# Admin + MCP keys (if using MCP gateway)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MCP_API_KEY=

# Keyed workflow configuration (all per-flow; shared fallback intentionally unused)
ANALYSIS_API_URL=https://stg-agentic.abafusion.ai/api/v1/run/supervisor
# ANALYSIS_API_TOKEN=Bearer <legacy shared jeton>   ← do not use; set the named tokens below

# Per-flow endpoints and tokens — same staging jeton today, edit individually later
SUPERVISOR_URL=https://stg-agentic.abafusion.ai/api/v1/run/supervisor
SUPERVISOR_TOKEN=Bearer <same-staging-jwt-for-now>
SELF_DISCOVERY_URL=https://stg-agentic.abafusion.ai/api/v1/run/self_discovery
SELF_DISCOVERY_TOKEN=Bearer <same-staging-jwt-for-now>
SKILLS_ASSESSMENT_URL=https://stg-agentic.abafusion.ai/api/v1/run/skills_assessment
SKILLS_ASSESSMENT_TOKEN=Bearer <same-staging-jwt-for-now>
DEVELOPMENT_PLANNER_URL=https://stg-agentic.abafusion.ai/api/v1/run/development_planner
DEVELOPMENT_PLANNER_TOKEN=Bearer <same-staging-jwt-for-now>
PROGRESS_REFLECTION_URL=https://stg-agentic.abafusion.ai/api/v1/run/progress_reflection
PROGRESS_REFLECTION_TOKEN=Bearer <same-staging-jwt-for-now>
CV_GAP_ANALYSIS_URL=https://stg-agentic.abafusion.ai/api/v1/run/cv_gap_analysis
CV_GAP_ANALYSIS_TOKEN=Bearer <same-staging-jwt-for-now>
QUALITY_GATE_URL=https://stg-agentic.abafusion.ai/api/v1/run/quality_gate
QUALITY_GATE_TOKEN=Bearer <same-staging-jwt-for-now>

# Local Langflow (fallback when no per-flow URL is set)
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=supervisor
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_SECONDS=120

# Long-running analysis webhook (reserved; not used by default)
ANALYSIS_WEBHOOK_URL=
ANALYSIS_WEBHOOK_TIMEOUT_SECONDS=5

# CV service (LangGraph) — handles upload/parse/save
CV_SERVICE_URL=http://localhost:8300

# Business rules
MAX_DEBT_RATIO=0.40
CORS_ORIGINS=http://localhost:3000
