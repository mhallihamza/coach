# langgraph .env.example — copy to .env and fill in. Never commit.
# Agents default to localhost trust — no bearer needed on this machine.
# Each agent owns its port (see config.PORTS). Override per-flow via:
#   SELF_DISCOVERY_URL / SELF_DISCOVERY_TOKEN … etc.

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-chat
LLM_TIMEOUT_SECONDS=90

MCP_URL=http://127.0.0.1:8310/mcp
MCP_TIMEOUT_MS=90000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/coach?retryWrites=true&w=majority
DATABASE_NAME=coach
