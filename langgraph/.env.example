# langgraph .env.example — copy to .env and fill in. Never commit .env.
# Per-flow URL/TOKEN pairs are optional overrides (HTTP only, no secrets are mandatory on localhost).
# If unset, agents are served from http://127.0.0.1:<PORT>/run/<slug> (see config.PORTS).
#
# LLM
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT_SECONDS=90
#
# MCP (tools layer for the agents — agents call it, nothing else should)
MCP_URL=http://127.0.0.1:8310/mcp
MCP_TIMEOUT_MS=90000
#
# Mongo (read-only, for conversation-history continuity)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/coach?retryWrites=true&w=majority
DATABASE_NAME=coach
#
# Per-flow overrides (leave empty to use localhost ports)
SELF_DISCOVERY_URL=
SELF_DISCOVERY_TOKEN=
SKILLS_ASSESSMENT_URL=
SKILLS_ASSESSMENT_TOKEN=
DEVELOPMENT_PLANNER_URL=
DEVELOPMENT_PLANNER_TOKEN=
PROGRESS_REFLECTION_URL=
PROGRESS_REFLECTION_TOKEN=
CV_GAP_ANALYSIS_URL=
CV_GAP_ANALYSIS_TOKEN=
QUALITY_GATE_URL=
QUALITY_GATE_TOKEN=
KNOWLEDGE_RAG_URL=
KNOWLEDGE_RAG_TOKEN=
