# langgraph .env.example — copy to .env and fill in. Never commit.
# These services default to localhost trust — no bearer needed on this machine.
# Each agent runs on its own port (see config.PORTS). Override any agent port via:
#   SELF_DISCOVERY_URL / SELF_DISCOVERY_TOKEN ... etc.

# LLM — Mistral (recommended)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=mstrl_...
MISTRAL_MODEL=ministral-8b-latest
LLM_TIMEOUT_SECONDS=90

# OpenRouter fallback
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=deepseek/deepseek-chat

# MCP (tools layer for the agents — agents call it, nothing else should)
MCP_URL=http://127.0.0.1:8310/mcp
MCP_TIMEOUT_MS=90000

# Mongo (read-only, for conversation-history continuity)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/coach?retryWrites=true&w=majority
DATABASE_NAME=coach
