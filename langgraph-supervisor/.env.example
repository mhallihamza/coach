# Evolve AI — LangGraph supervisor .env.example — copy to .env and fill in. Never commit.
# Every workflow carries its OWN named jeton below (even if they are identical today).
# To change one workflow only: edit its TOKEN line, then restart (py app\main.py).

# Shared BASE for workflow URLs (fallback only)
STG_BASE=https://stg-agentic.abafusion.ai/api/v1/run

# Shared jeton — intentionally unused; kept commented to avoid two sources of truth
# AGENTIC_TOKEN=Bearer <stg-jwt>
# ANALYSIS_API_TOKEN=Bearer <stg-jwt>   (also accepted as an alias)

# LLM
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Named jeton per workflow — same staging jeton today; edit individually later
SELF_DISCOVERY_URL=https://stg-agentic.abafusion.ai/api/v1/run/self_discovery
SELF_DISCOVERY_TOKEN=Bearer <same-staging-jwt-for-now>
SKILLS_ASSESSMENT_URL=https://stg-agentic.abafusion.ai/api/v1/run/skills_assessment
SKILLS_ASSESSMENT_TOKEN=Bearer <same-staging-jwt-for-now>
DEVELOPMENT_PLANNER_URL=https://stg-agentic.abafusion.ai/api/v1/run/development_planner
DEVELOPMENT_PLANNER_TOKEN=Bearer <same-staging-jwt-for-now>
PROGRESS_REFLECTION_URL=https://stg-agentic.abafusion.ai/api/v1/run/progress_reflection
PROGRESS_REFLECTION_TOKEN=Bearer <same-staging-jwt-for-now>
CV_GAP_ANALYSIS_URL=https://stg-agentic.abafusion.ai/api/v1/run/cv_gap_analysis
CV_GAP_ANALYSIS_TOKEN=Bearer <same-staging-jwt-for-now>
QUALITY_GATE_URL=https://stg-agentic.abafusion.ai/api/v1/run/quality_gate
QUALITY_GATE_TOKEN=Bearer <same-staging-jwt-for-now>
